APP_NAME=SIPETA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sipeta.example.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# IP proxy tepercaya (localhost & subnet internal Docker bridge)
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database (Mengarah ke container service 'db' - GANTI dengan password acak yang kuat)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sipeta
DB_USERNAME=sipeta_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# Cache, Session, & Queue (Hemat RAM: menggunakan Database, tanpa Redis)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Firebase Cloud Messaging (FCM HTTP v1)
FIREBASE_PROJECT_ID=reminderskejaksaan
FIREBASE_CREDENTIALS_PATH=firebase/service-account.json

